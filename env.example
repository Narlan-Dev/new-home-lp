## Caminho base de publicação (use "/" na raiz do domínio ou "/subpasta/")
VITE_APP_BASE_NAME = /

## Firebase — Console → Configurações do projeto → Seus apps → app Web → "Configuração do SDK"
## São identificadores públicos do app: quem protege os dados são as regras do banco e o Auth.
VITE_APP_FIREBASE_API_KEY=
VITE_APP_FIREBASE_AUTH_DOMAIN=<projectId>.firebaseapp.com
VITE_APP_FIREBASE_DATABASE_URL=https://<projectId>-default-rtdb.firebaseio.com
VITE_APP_FIREBASE_PROJECT_ID=
VITE_APP_FIREBASE_APP_ID=

## "true" aponta Auth e Database para os emuladores locais (veja .env.emulator e "yarn start:emulator")
VITE_APP_FIREBASE_USE_EMULATOR=false
