{
  "rules": {
    ".read": false,
    ".write": false,

    "chaCasaNova": {
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },

      "gifts": {
        ".read": true,

        "$giftId": {
          ".write": "auth != null && root.child('chaCasaNova').child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['name', 'price', 'url', 'order', 'createdAt', 'updatedAt'])",

          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
          "price": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
          "url": { ".validate": "newData.isString() && newData.val().length <= 2048 && newData.val().matches(/^https?:\\/\\/.+/)" },
          "image": { ".validate": "newData.isString() && newData.val().length <= 2048 && newData.val().matches(/^https?:\\/\\/.+/)" },
          "order": { ".validate": "newData.isNumber()" },
          "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
          "reserved": { ".validate": "newData.isBoolean()" },

          "$other": { ".validate": false }
        }
      }
    }
  }
}
