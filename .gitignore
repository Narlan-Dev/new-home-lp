# dependencies
node_modules
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# build
dist
*.tsbuildinfo

# env e segredos (nunca versionar)
.env
.env.*
!.env.emulator
.figma-token

# editor / sistema
.vscode/*
!.vscode/extensions.json
.DS_Store
*.log

# cópia local da cinova-portal usada só como referência de arquitetura (repositório git próprio, não faz parte deste projeto)
/cinova-portal

# snapshot local do design (JSON/PNG da API do Figma): regenerável com o token, não versionar
/design

# cópias de segurança do banco (yarn firebase:backup): dados do casal, ficam só na máquina
/backups

# credenciais do Firebase (chave de conta de serviço do Admin SDK): nunca versionar nem importar em src/
*firebase-adminsdk*.json
serviceAccount*.json
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
